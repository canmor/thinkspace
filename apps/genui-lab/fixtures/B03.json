{
  "root": "root",
  "elements": {
    "root": {
      "type": "Stack",
      "props": {},
      "children": [
        "summary",
        "aInput",
        "bInput",
        "cInput",
        "ranking"
      ]
    },
    "summary": {
      "type": "Text",
      "props": {
        "text": "Synthetic scores. Weights are normalized by their total."
      }
    },
    "aInput": {
      "type": "Control",
      "props": {
        "label": "Native experience",
        "value": {
          "$bindState": "/a"
        },
        "min": 0,
        "max": 100,
        "choices": []
      }
    },
    "bInput": {
      "type": "Control",
      "props": {
        "label": "Lightweight runtime",
        "value": {
          "$bindState": "/b"
        },
        "min": 0,
        "max": 100,
        "choices": []
      }
    },
    "cInput": {
      "type": "Control",
      "props": {
        "label": "Delivery efficiency",
        "value": {
          "$bindState": "/c"
        },
        "min": 0,
        "max": 100,
        "choices": []
      }
    },
    "ranking": {
      "type": "Table",
      "props": {
        "values": {
          "$computed": "Rank",
          "args": {
            "rows": [
              [
                "Native Hybrid",
                [
                  9,
                  8,
                  7
                ]
              ],
              [
                "Tauri",
                [
                  7,
                  8,
                  8
                ]
              ],
              [
                "Electron",
                [
                  6,
                  4,
                  10
                ]
              ]
            ],
            "a": {
              "$state": "/a"
            },
            "b": {
              "$state": "/b"
            },
            "c": {
              "$state": "/c"
            }
          }
        }
      }
    }
  }
}
